###############################################################################
# 6. ADVERTENCIA SOBRE ARCHIVOS YA TRACKEADOS
###############################################################################

# Si más adelante se activan patrones como *.pem, *.key o *.asc, los archivos
# que ya están en Git siguen trackeados. Para dejar de versionarlos:
#
#   git rm --cached certs/server_key.pem
#   git rm --cached contextoInicial/gpt_validar.txt
#
# Revisar antes con:
#
#   git ls-files | grep -E '\.(pem|key|p12|jks|asc)$'
#   git status --short
#
# Nunca hacer commit de claves privadas ni de tokens, aunque el archivo
# esté en .gitignore.
###############################################################################
